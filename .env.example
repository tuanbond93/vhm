# Public Environment Variables
NEXT_PUBLIC_SITE_URL=https://vanhanhmoi.com
NEXT_PUBLIC_ANALYTICS_ID=

# Email Delivery Provider (Resend)
# 1. Create API key at https://resend.com
# 2. Add RESEND_API_KEY to environment variables
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vận Hành Mới <no-reply@vanhanhmoi.com>

# Persistent Lead Storage (Postgres / Vercel Postgres / Neon / Supabase)
DATABASE_URL=

# Environment Provider Mode ('resend' | 'mock')
LEAD_CAPTURE_PROVIDER=resend
